# ==============================================================================
# PMU Backend Configuration Template
# ==============================================================================
# Copy this file to ".env" and fill in your actual values:
#   cp .env.example .env
# NEVER commit the actual ".env" file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# InfluxDB Configuration (Used by Node.js Server: server.js)
# ------------------------------------------------------------------------------
# Obtain these from your InfluxDB instance (cloud2.influxdata.com or local instance)
INFLUX_URL=https://us-east-1-1.aws.cloud2.influxdata.com
INFLUX_TOKEN=your_influxdb_api_token_here
INFLUX_ORG=your_organization_name
INFLUX_BUCKET=pmu_data

# ------------------------------------------------------------------------------
# Server Network Settings
# ------------------------------------------------------------------------------
# Port for the Node.js server (defaults to 3000 if omitted)
PORT=3000

# ------------------------------------------------------------------------------
# Device Authentication
# ------------------------------------------------------------------------------
# A shared secret token that PMU devices must send to authenticate their data frames.
# - Node.js server expects this in the JSON request body: { "api_key": "..." }
# - FastAPI server expects this in the HTTP header: "X-API-Key: ..."
DEVICE_API_KEY=replace_with_a_secure_random_device_key

# ------------------------------------------------------------------------------
# Relational Database Configuration (Used by Python FastAPI Server: main.py)
# ------------------------------------------------------------------------------
# SQLite (default for local development, zero setup needed):
DATABASE_URL=sqlite:///./pmu_data.db

# PostgreSQL / TimescaleDB (for production deployment):
# DATABASE_URL=postgresql://pmu_user:pmu_password@localhost:5432/pmu_db
